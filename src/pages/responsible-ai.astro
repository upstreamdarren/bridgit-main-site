---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookingSection from "../components/BookingSection.astro";

const packages = [
  {
    number: "01",
    title: "AI opportunity and risk review",
    timing: "A focused two week review",
    copy: "Choose the right starting point before you commit budget, data or staff time.",
    items: ["Priority use cases and user journeys", "Benefits, risks and people affected", "Data, ownership and supplier questions", "A practical shortlist with clear next decisions"]
  },
  {
    number: "02",
    title: "Responsible AI service design",
    timing: "A four to six week design sprint",
    copy: "Turn one promising idea into a service plan your teams, leaders and users can understand.",
    items: ["Service blueprint and human responsibilities", "Privacy, safeguarding and accessibility", "Content, boundaries and escalation routes", "Pilot measures, governance and delivery plan"]
  },
  {
    number: "03",
    title: "Pilot and assurance partner",
    timing: "An eight to twelve week pilot",
    copy: "Test the service with real people, gather evidence and decide whether it is ready to grow.",
    items: ["Prototype or configured AI coach", "User and workforce testing", "Quality, safety and failure testing", "Evaluation, assurance evidence and scale decision"]
  },
  {
    number: "04",
    title: "Ongoing responsible AI partner",
    timing: "Practical support each month",
    copy: "Keep governance useful as your portfolio, suppliers and live services change.",
    items: ["Use case and supplier reviews", "Governance forums and decision records", "Workforce learning and leadership briefings", "Outcome tracking and continuous improvement"]
  }
];
---

<BaseLayout
  title="Responsible AI Consultancy UK | Bridgit Care"
  description="Practical responsible AI consultancy for UK organisations. Choose worthwhile use cases, assess risk, design human-centred services and run assured pilots."
  image="/images/landing/responsible-ai-consultancy.webp"
>
  <main class="rai-page">
    <section class="section rai-hero">
      <div class="shell rai-hero-grid">
        <div>
          <p class="eyebrow">Responsible AI consultancy with social impact at its heart</p>
          <h1>Move from AI ambition to services people can trust.</h1>
          <p class="lead">Bridgit helps UK organisations choose worthwhile AI use cases, involve the people affected, manage risk and build practical governance into delivery from the start.</p>
          <div class="button-row">
            <a class="button button-pink" href="#book-a-call">Book an AI diagnostic call</a>
            <a class="button button-secondary" href="#consultancy-packages">See the packages</a>
          </div>
        </div>
        <figure class="rai-hero-visual">
          <img src="/images/landing/responsible-ai-consultancy.webp" alt="A diverse group shaping a responsible AI service around people, safeguards and community outcomes" width="1536" height="1024" />
          <figcaption>People, purpose and evidence shape every decision.</figcaption>
        </figure>
      </div>
    </section>

    <section class="section rai-question">
      <div class="shell">
        <div class="section-heading">
          <div><p class="eyebrow dark">The question behind the technology</p><h2>Should we use AI here, and can we do it well?</h2></div>
          <p>A responsible answer needs more than a policy. It needs a clear purpose, named owners, safe boundaries and evidence from the people who will use or deliver the service.</p>
        </div>
        <div class="human-scale-promise">
          <img src="/images/human-expertise-multiplied.webp" alt="One experienced team member extending their knowledge through several digital coaches" width="960" height="640" loading="lazy" />
          <p><strong>Imagine your best team member could support employees, customers or communities 24/7, without running out of capacity.</strong> We help you decide where that idea creates real value, where it introduces risk and what people need to remain in control.</p>
        </div>
        <div class="rai-risk-grid">
          <article><span>Purpose</span><h3>Start with a real need</h3><p>Define the human problem, the benefit you expect and why AI is a suitable part of the response.</p></article>
          <article><span>People</span><h3>Involve those affected</h3><p>Bring users, frontline staff and leaders into the design before important choices become difficult to change.</p></article>
          <article><span>Protection</span><h3>Design for the difficult moments</h3><p>Set boundaries, consent, privacy, accessibility, safeguarding and a clear route to a real person.</p></article>
          <article><span>Proof</span><h3>Measure value and harm</h3><p>Track useful outcomes, service impact, quality, exclusion and failure so leaders can make informed decisions.</p></article>
        </div>
      </div>
    </section>

    <section class="section rai-method">
      <div class="shell rai-method-grid">
        <div>
          <p class="eyebrow">Our approach</p>
          <h2>Governance that helps people deliver, not paperwork that sits on a shelf.</h2>
          <p>We combine social impact practice, service design, product delivery and lived experience. The result is a clear path from opportunity to a tested service, with decisions and responsibilities that teams can actually use.</p>
          <a class="button button-secondary" href="#book-a-call">Talk through a use case</a>
        </div>
        <ol>
          <li><span>01</span><div><h3>Choose</h3><p>Find the use cases with a valuable human outcome and a realistic route to delivery.</p></div></li>
          <li><span>02</span><div><h3>Design</h3><p>Shape the service, human roles, data, safeguards and measures together.</p></div></li>
          <li><span>03</span><div><h3>Test</h3><p>Run a contained pilot with real users, staff involvement and clear stop points.</p></div></li>
          <li><span>04</span><div><h3>Learn</h3><p>Use evidence to improve, scale carefully or decide that AI is not the right answer.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="section rai-packages" id="consultancy-packages">
      <div class="shell">
        <div class="section-heading">
          <div><p class="eyebrow dark">Consultancy packages</p><h2>Start at the point that matches your organisation.</h2></div>
          <p>Each package produces useful decisions and working materials. You can use one on its own or continue into the next stage.</p>
        </div>
        <div class="rai-package-grid">
          {packages.map((item) => (
            <article>
              <div class="rai-package-heading"><span>{item.number}</span><small>{item.timing}</small></div>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
              <ul>{item.items.map((point) => <li>{point}</li>)}</ul>
              <a href="#book-a-call">Discuss this package <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section rai-social-impact">
      <div class="shell rai-impact-grid">
        <div><p class="eyebrow">Social impact is not an extra measure</p><h2>Ask who benefits, who may be left out and what changes in real life.</h2></div>
        <div class="rai-impact-points">
          <p><strong>For the people using it</strong><span>Is the service understandable, accessible and useful at the point of need?</span></p>
          <p><strong>For the workforce</strong><span>Does it protect judgement and relationships while reducing repetitive work?</span></p>
          <p><strong>For communities</strong><span>Does it strengthen trusted routes to support rather than create another disconnected channel?</span></p>
          <p><strong>For leaders</strong><span>Can you explain the value, risks, decisions and evidence with confidence?</span></p>
        </div>
      </div>
    </section>

    <section class="section rai-tools" aria-labelledby="rai-tools-title">
      <div class="shell">
        <div class="section-heading">
          <div><p class="eyebrow dark">Try a guided tool</p><h2 id="rai-tools-title">Put responsible practice into the conversation.</h2></div>
          <p>Use a focused Bridgit coach to work through two common starting points. Both tools use trusted public-service guidance and can email you a practical plan at the end.</p>
        </div>
        <div class="rai-tool-grid">
          <a href="/sandy">
            <img src="/images/tools/sandy-coproduction-watercolour.jpg" alt="Sandy, Bridgit's co-production coach" width="1536" height="1024" loading="lazy" />
            <span><small>Co-production</small><strong>Build an inclusive co-production plan with Sandy</strong><em>Open the free tool →</em></span>
          </a>
          <a href="/commissioners-digital-toolkit">
            <img src="/images/tools/commissioner-toolkit-hero.webp" alt="Commissioners exploring community needs and digital options" width="1536" height="1024" loading="lazy" />
            <span><small>Digital commissioning</small><strong>Turn a service challenge into a confident digital brief</strong><em>Open the free tool →</em></span>
          </a>
        </div>
      </div>
    </section>

    <BookingSection title="Bring us the AI question your organisation is trying to answer." copy="Book a call to discuss the opportunity, the people affected and the safest useful next step. We will tell you honestly whether that should be a review, a design sprint, a pilot or no AI at all." />
  </main>
</BaseLayout>

<style>
  .rai-hero{overflow:hidden;background:radial-gradient(circle at 8% 14%,rgba(204,45,169,.21),transparent 30%),linear-gradient(135deg,#2f0d5c 0%,#5d1ba3 52%,#225987 100%);color:#fff}
  .rai-hero-grid{display:grid;grid-template-columns:.92fr 1.08fr;gap:clamp(42px,7vw,94px);align-items:center}
  .rai-hero h1{max-width:750px;margin:12px 0 24px;font-size:clamp(48px,6.7vw,86px);line-height:.99}
  .rai-hero .lead{max-width:680px;color:#eee8f5;font-size:20px}
  .rai-hero-visual{overflow:hidden;margin:0;border:1px solid rgba(255,255,255,.25);border-radius:36px;background:#f8f4fb;box-shadow:0 30px 80px rgba(20,5,39,.3);transform:rotate(1deg)}
  .rai-hero-visual img{display:block;width:100%;height:auto}
  .rai-hero-visual figcaption{padding:14px 20px;background:#fff;color:#351057;font-size:13px;font-weight:900;text-align:center}
  .rai-question{background:#fff}
  .rai-risk-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
  .rai-risk-grid article{padding:28px;border:1px solid #e5dced;border-radius:24px;background:linear-gradient(145deg,#fff,#faf7fc);box-shadow:0 15px 38px rgba(47,17,77,.07)}
  .rai-risk-grid span{color:#c12ca8;font-size:12px;font-weight:900;letter-spacing:.1em;text-transform:uppercase}
  .rai-risk-grid h3{margin:14px 0 9px;color:#4b168a;font-size:22px}
  .rai-risk-grid p{margin:0;color:#5d5768;font-size:14px}
  .rai-method{background:linear-gradient(135deg,#35105f,#6330a9 60%,#235d8b);color:#fff}
  .rai-method-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(40px,7vw,90px);align-items:center}
  .rai-method h2{margin:10px 0 22px;font-size:clamp(40px,5vw,64px);line-height:1.02}
  .rai-method p{color:#e6ddef}
  .rai-method ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin:0;padding:0;list-style:none}
  .rai-method li{display:grid;grid-template-columns:44px 1fr;gap:13px;padding:21px;border:1px solid rgba(255,255,255,.2);border-radius:20px;background:rgba(255,255,255,.09)}
  .rai-method li>span{display:grid;place-items:center;width:44px;height:44px;border-radius:14px;background:#fff;color:#621fb0;font-size:12px;font-weight:900}
  .rai-method h3{margin:2px 0 5px;font-size:20px}
  .rai-method li p{margin:0;font-size:13px}
  .rai-packages{background:#faf8fc}
  .rai-package-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
  .rai-package-grid article{padding:32px;border:1px solid #e3d8eb;border-radius:28px;background:#fff;box-shadow:0 18px 44px rgba(45,16,73,.08)}
  .rai-package-heading{display:flex;align-items:center;justify-content:space-between;gap:16px}
  .rai-package-heading>span{display:grid;place-items:center;width:48px;height:48px;border-radius:15px;background:linear-gradient(135deg,#6120af,#c62aaa);color:#fff;font-weight:900}
  .rai-package-heading small{color:#655d70;font-weight:800}
  .rai-package-grid h3{margin:22px 0 11px;color:#50158e;font-size:28px}
  .rai-package-grid p{color:#5f586b}
  .rai-package-grid ul{display:grid;gap:9px;margin:22px 0;padding:0;list-style:none}
  .rai-package-grid li{position:relative;padding-left:23px;color:#423a4c;font-size:14px}
  .rai-package-grid li:before{content:"✓";position:absolute;left:0;color:#2d9a79;font-weight:900}
  .rai-package-grid a{color:#4b117f;font-weight:900}
  .rai-social-impact{background:#fff}
  .rai-impact-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(40px,7vw,92px);align-items:center}
  .rai-social-impact h2{margin:10px 0 0;font-size:clamp(39px,5vw,62px);line-height:1.04}
  .rai-impact-points{display:grid;gap:12px}
  .rai-impact-points p{display:grid;grid-template-columns:180px 1fr;gap:20px;margin:0;padding:19px;border:1px solid #e4daec;border-radius:18px;background:#fbf9fd}
  .rai-impact-points strong{color:#571896}
  .rai-impact-points span{color:#5f586b}
  .rai-tools{background:#faf8fc}
  .rai-tool-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
  .rai-tool-grid>a{display:grid;grid-template-columns:42% 1fr;overflow:hidden;border:1px solid #e3d8eb;border-radius:28px;background:#fff;color:inherit;text-decoration:none;box-shadow:0 18px 44px rgba(45,16,73,.08);transition:transform .2s ease,box-shadow .2s ease}
  .rai-tool-grid>a:hover{transform:translateY(-4px);box-shadow:0 24px 54px rgba(45,16,73,.13)}
  .rai-tool-grid img{width:100%;height:100%;min-height:250px;object-fit:cover}
  .rai-tool-grid span{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:28px}
  .rai-tool-grid small{color:#c12ca8;font-size:12px;font-style:normal;font-weight:900;letter-spacing:.1em;text-transform:uppercase}
  .rai-tool-grid strong{margin:12px 0 20px;color:#48117f;font-size:23px;line-height:1.15}
  .rai-tool-grid em{color:#43116f;font-size:14px;font-style:normal;font-weight:900}
  @media(max-width:980px){.rai-hero-grid,.rai-method-grid,.rai-impact-grid{grid-template-columns:1fr}.rai-risk-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:760px){.rai-tool-grid{grid-template-columns:1fr}.rai-tool-grid>a{grid-template-columns:1fr}.rai-tool-grid img{height:230px;min-height:0}}
  @media(max-width:680px){.rai-risk-grid,.rai-method ol,.rai-package-grid{grid-template-columns:1fr}.rai-hero-visual{border-radius:25px}.rai-impact-points p{grid-template-columns:1fr;gap:6px}}
</style>
