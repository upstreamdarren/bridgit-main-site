---
import BaseLayout from "../layouts/BaseLayout.astro";
import SupportSelector from "../components/SupportSelector.astro";

const steps = [
  ["01", "Choose your team", "Select priority problems and the human expertise the coaches should scale."],
  ["02", "Train them", "Use approved local content, tone, pathways, safeguards and handover rules to your real-world support."],
  ["03", "Deploy them", "Launch through web, voice, hosted links, QR codes and trusted partners."],
  ["04", "See impact", "Track people supported, needs, actions, check-ins, feedback and handovers."]
];

const partners = [
  ["BCP Council", "/images/partners/bcp-council.png"],
  ["Dudley Metropolitan Borough Council", "/images/partners/dudley-council.png"],
  ["Cambridgeshire County Council", "/images/partners/cambridgeshire-council.png"],
  ["Peterborough City Council", "/images/partners/peterborough-council.png"],
  ["Sandwell Council", "/images/partners/sandwell-council.webp"],
  ["Microsoft", "/images/partners/microsoft.png"]
];

const useCases = [
  { title: "Adult carers", copy: "Personalised guidance for unpaid carers, hidden carers and people balancing work with caring.", image: "/images/use-cases-v2/adult-carers.webp", service: "https://carers.bridgit.care/", caseStudy: "https://bridgit.care/wp-content/uploads/2025/10/Carers-1pp-Case-Study.pdf" },
  { title: "Young carers", copy: "Friendly support for young people balancing school, home life and a caring role.", image: "/images/use-cases-v2/young-carers.webp", service: "https://young.bridgit.care/", caseStudy: "https://bridgit.care/wp-content/uploads/2025/10/Young-Carers-1pp-Case-Study.pdf" },
  { title: "Employers", copy: "Practical help for employees, managers and organisations building carer-friendly workplaces.", image: "/images/use-cases-v2/employers.webp", service: "https://employers.bridgit.care/" },
  { title: "Local support", copy: "A clear route into trusted local help for residents who may not know where to turn.", image: "/images/use-cases-v2/local-support.webp", service: "https://local.bridgit.care/" },
  { title: "Care leavers", copy: "A steady source of guidance for young people navigating housing, health, education and adulthood.", image: "/images/use-cases-v2/care-leavers.webp", service: "https://next.bridgit.care/", caseStudy: "https://bridgit.care/wp-content/uploads/2025/10/Next-1pp-Case-Study.pdf" },
  { title: "Healthy ageing", copy: "Early, practical support that helps people stay active, connected and independent.", image: "/images/use-cases-v2/healthy-ageing.webp", service: "https://agewell.bridgit.care/", caseStudy: "https://bridgit.care/wp-content/uploads/2025/10/AgeWell-1pp-Case-Study.pdf" }
];
---

<BaseLayout
  title="Bridgit Care | AI-powered coaching for stronger communities"
  description="Bridgit Care helps councils, charities and social enterprises scale trusted support with safe, accessible AI coaches."
>
  <section class="hero section">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow dark">AI-powered coaching for councils, charities and social enterprises</p>
        <h1>Turn the knowledge of your best people into support that <span>never switches off.</span></h1>
        <p class="lead">Bridgit helps organisations turn their knowledge, services and local information into digital coaches. They provide trusted guidance 24/7, check in as people’s needs change and help teams reach more people while measuring the impact created.</p>
        <div class="button-row">
          <a class="button" href="#how-it-works">See how Bridgit works</a>
          <a class="button button-secondary" href="#book-a-call">Book a discovery call</a>
        </div>
        <button class="support-trigger" type="button" data-support-open aria-haspopup="dialog">
          <span aria-hidden="true">♥</span>
          <span><strong>Looking for support?</strong> Choose the right Bridgit service</span>
          <span aria-hidden="true">→</span>
        </button>
      </div>
      <div class="hero-media">
        <img src="/images/support-process.png" alt="Bridgit turns human expertise into multiple digital coaches, supports more people and measures impact" width="1536" height="1024" />
      </div>
    </div>
  </section>

  <SupportSelector />

  <section class="proof section-compact" aria-label="Bridgit reach">
    <div class="shell proof-grid">
      <div><strong>200,000+</strong><span>people supported</span></div>
      <div><strong>40</strong><span>UK local authority areas</span></div>
      <div><strong>Trusted by</strong><span>councils, charities and social enterprises</span></div>
    </div>
    <div class="shell trusted-partners" aria-label="Selected Bridgit partners">
      <p>Working with organisations across the UK</p>
      <div class="partner-logos">
        {partners.map(([name, src]) => <img src={src} alt={name} loading="lazy" />)}
      </div>
    </div>
  </section>

  <section class="section intro">
    <div class="shell split-heading">
      <div><p class="eyebrow dark">Smarter support, made human</p><h2>Help more people without stretching your team further.</h2></div>
      <div><p class="lead-small">From carers and young people to workplaces and whole communities, Bridgit gives people guidance when they need it and gives organisations the insight to reach further and intervene earlier.</p><p>We are a UK social enterprise built around a simple mission: no one should face life’s challenges alone.</p></div>
    </div>
  </section>

  <section class="section how" id="how-it-works">
    <div class="shell">
      <p class="eyebrow dark">How it works</p>
      <div class="section-heading"><h2>Build a digital team around your expertise.</h2><p>Choose where coaches can help, train them in your approved approach, deploy them through trusted channels and see the impact they create.</p></div>
      <ol class="steps">
        {steps.map(([number, title, copy]) => (
          <li><span>{number}</span><h3>{title}</h3><p>{copy}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section use-cases" id="support">
    <div class="shell">
      <p class="eyebrow dark">Where Bridgit helps</p>
      <div class="section-heading"><h2>Start with a proven template. Make it yours.</h2><p>Use an established model for a priority community, then shape the knowledge, pathways and safeguards around your organisation.</p></div>
      <div class="usecase-grid">
        {useCases.map(({ title, copy, image, service, caseStudy }) => (
          <article class="usecase-card">
            <img src={image} alt="" loading="lazy" width="500" height="500" />
            <div class="usecase-card-copy">
              <h3>{title}</h3>
              <p>{copy}</p>
              <div class="usecase-links">
                <a href={service}>Explore service <span aria-hidden="true">→</span></a>
                {caseStudy && <a href={caseStudy}>Read case study</a>}
              </div>
            </div>
          </article>
        ))}
        <article class="usecase-card usecase-card-bespoke">
          <div class="bespoke-mark" aria-hidden="true">?</div>
          <div class="bespoke-copy">
            <p class="bespoke-kicker">Something different?</p>
            <h3>Your idea doesn’t need to fit a template.</h3>
            <p>If you have a different service model, priority or idea, bring it to us. We can create bespoke coaches and digital team members with you in hours.</p>
          </div>
          <a class="button button-light" href="#book-a-call">Talk through your idea</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section coach-demo" aria-labelledby="coach-demo-title">
    <div class="shell coach-demo-inner">
      <div>
        <p class="eyebrow">Try it yourself</p>
        <h2 id="coach-demo-title">Ask a Bridgit coach.</h2>
      </div>
      <div>
        <p>Our main Bridgit coach is available on this page to answer questions about Bridgit, our services and how we work. Use the coach button in the bottom-right corner to start.</p>
        <p class="coach-note">One clear coach here. Specialist coaches can be introduced on future campaign pages.</p>
      </div>
    </div>
  </section>

  <section class="section teams">
    <div class="shell teams-grid">
      <div class="teams-copy"><p class="eyebrow">For service teams</p><h2>AI that supports your users and your people.</h2><p>Keep people engaged between appointments, reduce repetitive admin and help frontline teams act with confidence.</p><a class="button button-light" href="#book-a-call">Talk through your challenge</a></div>
      <div class="feature-list">
        <article><span>01</span><div><h3>Smart support plans</h3><p>Personalised, practical plans created from each person’s needs.</p></div></article>
        <article><span>02</span><div><h3>Continuous coaching</h3><p>Regular check-ins and appropriate escalation when needs change.</p></div></article>
        <article><span>03</span><div><h3>Better team insight</h3><p>A clearer view of demand, progress and the outcomes your service creates.</p></div></article>
      </div>
    </div>
  </section>

  <section class="section booking" id="book-a-call">
    <div class="shell booking-grid">
      <div class="booking-copy">
        <p class="eyebrow dark">Book a discovery call</p>
        <h2>Let’s explore where a Bridgit coach could make the biggest difference.</h2>
        <p>Choose a convenient 30-minute slot with Laura to discuss your priority audiences, existing expertise and a practical route to launch.</p>
      </div>
      <div class="calendly-card">
        <iframe
          class="calendly-frame"
          title="Book a 30-minute Bridgit discovery call with Laura"
          src="https://calendly.com/laura-upstreamoutcomes/30min?embed_domain=bridgit.care&embed_type=Inline&hide_event_type_details=1&hide_gdpr_banner=1&primary_color=c300ff"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>

  <elevenlabs-convai
    agent-id="agent_9001k5y0ara8ej0tqx19x61wcqkq"
    variant="expanded"
    dismissible="true"
    avatar-orb-color-1="#4f8fc0"
    avatar-orb-color-2="#a329b8"
    action-text="Ask Bridgit"
    start-call-text="Talk to Bridgit"
    end-call-text="End conversation"
    expand-text="Open Bridgit coach"
    listening-text="Bridgit is listening…"
    speaking-text="Bridgit is speaking…"
    markdown-link-allowed-hosts="bridgit.care"
    markdown-link-include-www="true"
  ></elevenlabs-convai>
  <script is:inline src="https://unpkg.com/@elevenlabs/convai-widget-embed" async type="text/javascript"></script>
</BaseLayout>
