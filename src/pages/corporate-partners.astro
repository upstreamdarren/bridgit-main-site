  description: "Choose a Bridgit partnership that supports your employees, customers or communities, or fund a mission cohort of trusted social enterprises.",
  pageClass: "audience-corporate",
  eyebrow: "For corporate partners and social value leaders",
  heroTitle: "Choose how you want Bridgit to create value.",
  heroIntro: "Support people inside your own organisation with AI coaches, or fund a group of trusted social enterprises around one shared mission.",
  coreAudience: "employees, customers or communities",
  heroNote: "Start with the route that matches your priority and budget today. You can connect both routes later.",
  heroImage: "/images/landing/corporate-partners-hero.webp",
  heroAlt: "A corporate leader connecting employee, customer and community support with measurable impact",
  heroHighlights: ["Support your own people", "Fund a shared mission", "See measurable value"],
  partnershipLabel: "A Social Enterprise UK Members' Partner",
