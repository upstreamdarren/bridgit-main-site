    { title: "More people supported", copy: "Extend trusted services beyond one to one capacity and office hours." },
    { title: "Stronger social enterprises", copy: "Leave each organisation with reusable digital coaching capacity and learning." },
    { title: "One impact story", copy: "Bring cohort reach, needs, actions, referrals and outcomes into one clear report." },
    { title: "Local expertise retained", copy: "Members keep ownership of their knowledge, relationships and delivery identity." },
    { title: "A scalable investment model", copy: "Start with a small cohort, learn what works and expand across places or missions." },
    { title: "Clear next decisions", copy: "Use evidence to decide what to repeat, improve, integrate, expand or stop." }
  ],
  personValueTitle: "Support that stays local and becomes easier to reach",
  personValue: "People receive personalised guidance from organisations they trust, plus a clear route to human help when they need more.",
  organisationValueTitle: "Investment that builds delivery capability",
  organisationValue: "Cohort members gain practical technology and shared learning, while the investor sees collective impact clearly.",
  caseStudies: [
    { eyebrow: "Social enterprise delivery", title: "See how Bridgit helps mission led organisations scale.", copy: "The Social Enterprises page explains the direct offer for organisations that want to turn their own expertise into AI coaching.", result: "A flexible route from one focused coach to a complete integrated service.", href: "/social-enterprises", linkLabel: "Explore AI coaching for social enterprises" },
    { eyebrow: "Need support inside your organisation?", title: "Procure AI coaches for employees, customers or communities.", copy: "Corporate partners can deploy Bridgit directly around their own approved knowledge, policies and service pathways.", result: "One focused journey, safe human handovers and measurable service insight.", href: "/corporate-partners", linkLabel: "Explore corporate AI coaching" }
  ],
  testimonialTitle: "Hear from organisations creating practical social impact.",
  testimonialCopy: "Our partners explain what it feels like to extend trusted support while keeping real people and relationships at the centre.",
  featuredTestimonial: "andy",
  bookingTitle: "Which mission could a cohort help you scale?",
  bookingCopy: "Book a call to discuss the population, outcome, potential delivery partners, investment range and evidence your organisation needs.",
  agentId: "agent_9101m0a09yjkezpvpamtcvdt3p4r",
  coachActionText: "Ask about social investment",
  coachQuestions: ["How does a mission cohort work?", "What evidence would we receive?", "How many social enterprises should we fund?"]
