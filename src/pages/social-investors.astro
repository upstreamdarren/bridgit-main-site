  ],
  story: {
    eyebrow: "A typical social investment journey",
    title: "Meet Leah. She wants one investment to strengthen several trusted organisations.",
    intro: "Leah represents a corporate foundation, social investor or funder focused on a mission such as financial resilience, employment, caring, health equity or secure homes.",
    personName: "Leah, social investment lead",
    personContext: "Responsible for turning a strategic commitment into practical community support and credible evidence.",
    personImage: "/images/landing/corporate-leah.webp",
    personAlt: "Illustrated portrait representing Leah, a social investment lead",
    beforeTitle: "Leah funds good work but receives separate delivery stories",
    beforeItems: ["Each organisation starts with different digital capacity.", "Short grants can create activity without reusable infrastructure.", "Measures vary, making collective impact difficult to compare.", "People still experience disconnected routes into support."],
