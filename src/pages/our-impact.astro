---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookingSection from "../components/BookingSection.astro";
import partners from "../data/partners.json";

const caseStudies = [
  {
    place: "Peterborough",
    metric: "10%",
    label: "more carers supported in a few months",
    copy: "The service combined direct conversations with GP and health service presentations, local radio and accessible videos in six languages and BSL.",
    logo: "/images/clients/peterborough-council.png",
    logoAlt: "Peterborough City Council",
    href: "https://bridgit.care/supporting-unpaid-carers-peterborough-city-council/blog",
    link: "Read the Peterborough story"
  },
  {
    place: "North Lincolnshire",
    metric: "100",
    label: "additional carers identified in one GP trial",
    copy: "A simple approach used existing SMS and patient record systems to help a practice identify and code carers, creating an earlier route into support.",
    logo: "/images/clients/north-lincolnshire-council.svg",
    logoAlt: "North Lincolnshire Council",
    href: "https://bridgit.care/carer-identification-scheme-case-study/blog",
    link: "Read the identification case study"
  },
  {
    place: "Birmingham",
    metric: "One",
    label: "approachable local front door",
    copy: "Brum Chat was co-designed with residents and council teams. Its local digital coaches connect people to preventative help across housing, money, employment and wellbeing.",
    logo: "/images/clients/birmingham-city-council.png",
    logoAlt: "Birmingham City Council",
    href: "https://bridgit.care/wp-content/uploads/2025/10/Local-1pp-Case-Study.pdf",
    link: "View the Brum Chat case study"
  }
];

const outcomes = [
  { number: "01", title: "Understand", copy: "Turn a complicated situation into clear, manageable parts." },
  { number: "02", title: "Decide", copy: "Compare options and identify the most useful next step." },
  { number: "03", title: "Act", copy: "Prepare questions, send the email, make the call or start the plan." },
  { number: "04", title: "Connect", copy: "Reach the right local service or person when more help is needed." }
];

const voices = [
  "For carers who have no time, it’s brilliant and makes you feel you’re not alone.",
  "The website is lovely and clear to understand. No jargon, which is what I like.",
  "It’s just knowing support is there that is reassuring.",
  "It was simple to use and full of relevant information. I would strongly recommend it.",
  "I intend to take their advice and go forward with my plans.",
  "Great support, understanding and information. So valuable. Thank you."
];

const learning = [
  { title: "Listen every month", copy: "Our monthly user group brings carers and services together to tell us what people want next." },
  { title: "Build what matters", copy: "We turn that feedback into clearer journeys, more useful tools and stronger local connections." },
  { title: "Keep learning", copy: "We review conversations and service evidence so each iteration is grounded in real use, not assumptions." }
];
---

<BaseLayout
  title="Our Impact | Client Stories and Carer Evidence | Bridgit Care"
  description="See how Bridgit helps carers, councils and local services reach people earlier through practical digital support, trusted local pathways and warm human handovers."
  image="/images/impact-hero-story.webp"
>
  <section class="impact-hero section">
    <div class="shell impact-hero-grid">
      <div class="impact-hero-copy">
        <p class="eyebrow dark">People, progress and lasting change</p>
        <h1>Impact begins when the right support reaches someone <span>sooner.</span></h1>
        <p class="lead">Bridgit helps people make sense of difficult situations, take a practical next step and connect with trusted human support. The stories on this page show what that looks like for individuals, services and whole communities.</p>
        <div class="button-row">
          <a class="button" href="#case-studies">See the client stories</a>
          <a class="button button-secondary" href="#book-a-call">Talk to us about impact</a>
        </div>
      </div>
      <figure class="impact-hero-visual">
        <img src="/images/impact-hero-story.webp" alt="A family carer moving from a difficult moment to digital guidance and trusted local human support" width="1600" height="1067" fetchpriority="high" />
        <figcaption>
          <span>Personal concern</span>
          <span>Clear next steps</span>
          <span>Human support</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="impact-reach" aria-label="Bridgit reach and delivery footprint">
    <div class="shell impact-reach-grid">
      <article><strong>200,000+</strong><span>people supported through Bridgit services</span></article>
      <article><strong>{partners.length}</strong><span>partner and delivery organisations represented</span></article>
      <article><strong>60</strong><span>UK local-authority areas in the current footprint</span></article>
      <p>Reach matters, but it is only the beginning. We pair these headline numbers with client stories, direct user feedback and practical evidence of what people did next.</p>
    </div>
  </section>

  <section class="section impact-origin" aria-labelledby="origin-title">
    <div class="shell impact-origin-grid">
      <div class="impact-origin-heading">
        <p class="eyebrow dark">Why Bridgit exists</p>
        <h2 id="origin-title">It started with one family asking why help was so hard to reach.</h2>
      </div>
      <div class="impact-origin-story">
        <p>Darren’s grandad Doug fell at home and struggled to reach help. Darren’s mum Jacqueline was his main carer, carrying the responsibility families so often absorb quietly.</p>
        <p>That experience made the gap painfully clear. Useful support existed, but finding it at the right moment was too difficult. Bridgit grew from a simple question: <strong>what if people could find the right support before life reached crisis point?</strong></p>
        <a href="https://darrencrombie.com/" target="_blank" rel="noreferrer">Read Darren’s founder story →</a>
      </div>
      <ol class="impact-origin-moments">
        <li><span>01</span><strong>A difficult moment</strong><p>A family needs help, often without knowing where to begin.</p></li>
        <li><span>02</span><strong>A gap made visible</strong><p>Good local support exists, but the route into it is fragmented or unclear.</p></li>
        <li><span>03</span><strong>A better model</strong><p>Digital coaching provides earlier guidance while keeping people connected to real services.</p></li>
      </ol>
    </div>
  </section>

  <section class="section impact-case-studies" id="case-studies" aria-labelledby="case-studies-title">
    <div class="shell">
      <div class="section-heading impact-heading">
        <div>
          <p class="eyebrow dark">Client spotlights</p>
          <h2 id="case-studies-title">Local challenges. Practical change people can feel.</h2>
        </div>
        <p>Each partnership starts with a real service pressure. The model is then shaped around local people, trusted routes and the outcomes that matter in that place.</p>
      </div>
      <div class="impact-case-grid">
        {caseStudies.map(({ place, metric, label, copy, logo, logoAlt, href, link }, index) => (
          <article class:list={[index === 0 && "impact-case-feature"]}>
            <div class="impact-case-top">
              <span>{place}</span>
              <div class="impact-case-logo"><img src={logo} alt={logoAlt} loading="lazy" /></div>
            </div>
            <div class="impact-case-number"><strong>{metric}</strong><span>{label}</span></div>
            <p>{copy}</p>
            <a href={href} target="_blank" rel="noreferrer">{link} →</a>
          </article>
        ))}
      </div>
      <blockquote class="impact-partner-quote">
        <span aria-hidden="true">“</span>
        <p>Brum Chat is a linchpin in Birmingham’s prevention strategy, engaging residents before their needs escalate and easing pressure on our teams.</p>
        <cite>Philip Fletcher, Head of Early Intervention, Birmingham City Council</cite>
      </blockquote>
    </div>
  </section>

  <section class="section impact-pathway" aria-labelledby="pathway-title">
    <div class="shell">
      <div class="section-heading impact-heading">
        <div>
          <p class="eyebrow dark">The impact pathway</p>
          <h2 id="pathway-title">Support should change what happens next.</h2>
        </div>
        <p>The clearest pattern is a practical journey from uncertainty to action. Bridgit gives people a clear digital front door, helps them prepare and connects them to local services. It does not replace those services.</p>
      </div>
      <ol class="impact-flow">
        {outcomes.map(({ number, title, copy }) => (
          <li><span>{number}</span><h3>{title}</h3><p>{copy}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section impact-story" aria-labelledby="story-title">
    <div class="shell impact-story-grid">
      <div class="impact-story-copy">
        <p class="eyebrow">One person’s journey</p>
        <h2 id="story-title">From a difficult hospital discharge to practical progress at home.</h2>
        <p>One carer used Bridgit to organise questions about discharge, care arrangements and safety equipment. They took those questions to the occupational therapist and care coordinator, then returned with an update.</p>
        <blockquote>“I asked them all the questions you helped me with and they got back to me quickly with answers.”</blockquote>
      </div>
      <div class="impact-story-steps">
        <article><span>01</span><div><h3>Prepared</h3><p>Bridgit helped the carer break the situation down and prepare the right questions.</p></div></article>
        <article><span>02</span><div><h3>Connected</h3><p>The carer spoke to the professionals responsible for discharge and home safety.</p></div></article>
        <article><span>03</span><div><h3>Progressed</h3><p>A chair and Zimmer frame were ordered and two additional handrails were arranged.</p></div></article>
        <p class="impact-story-result">“Thank you for all your advice. I reckon it was the nudge needed.”</p>
      </div>
    </div>
  </section>

  <section class="section impact-voices" aria-labelledby="voices-title">
    <div class="shell">
      <div class="section-heading impact-heading">
        <div>
          <p class="eyebrow dark">In carers’ own words</p>
          <h2 id="voices-title">What useful support feels like.</h2>
        </div>
        <p>These are direct, anonymised comments from carers. We have only made minor punctuation corrections for readability.</p>
      </div>
      <div class="impact-quotes">
        {voices.map((quote, index) => (
          <blockquote class:list={[index === 0 && "impact-quote-feature"]}>
            <span aria-hidden="true">“</span>
            <p>{quote}</p>
            <cite>Direct carer feedback, anonymised</cite>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="section impact-learning" aria-labelledby="learning-title">
    <div class="shell">
      <div class="section-heading impact-heading">
        <div>
          <p class="eyebrow dark">Built with users and services</p>
          <h2 id="learning-title">Listen, learn, improve, repeat.</h2>
        </div>
        <p>Bridgit is never treated as finished. We continually iterate with the people using it and the services around them, including a monthly user group that helps us understand what people want and get useful changes delivered.</p>
      </div>
      <div class="impact-learning-grid">
        {learning.map(({ title, copy }, index) => (
          <article><span>{String(index + 1).padStart(2, "0")}</span><h3>{title}</h3><p>{copy}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section impact-validation" aria-labelledby="validation-title">
    <div class="shell impact-validation-grid">
      <div>
        <p class="eyebrow dark">Independent recognition</p>
        <h2 id="validation-title">Built with scrutiny, partnership and social purpose.</h2>
        <p>Bridgit’s work has been supported and profiled by national innovation programmes focused on better health, care and inclusion.</p>
      </div>
      <div class="impact-validation-links">
        <a href="https://iuk-business-connect.org.uk/projects/inclusive-innovation/bridgit-care/" target="_blank" rel="noreferrer"><span>Innovate UK Business Connect</span><strong>Inclusive Innovation Award</strong><small>Read the external project profile →</small></a>
        <a href="https://sbrihealthcare.co.uk/impact-case-studies/case-studies/bridgit-care" target="_blank" rel="noreferrer"><span>SBRI Healthcare</span><strong>Health innovation case study</strong><small>Read the external case study →</small></a>
      </div>
    </div>
  </section>

  <section class="section impact-next-voices">
    <div class="shell impact-next-voices-inner">
      <div><p class="eyebrow dark">The next chapter</p><h2>More first-person stories are coming.</h2></div>
      <p>We are preparing a fuller collection of user testimonials so people can hear directly from those who have used Bridgit. Until then, this page will stay grounded in the stories and evidence we can substantiate.</p>
    </div>
  </section>

  <BookingSection
    title="Let’s define the impact your service needs to create."
    copy="Bring us your priority audience, service pressure and existing evidence. We’ll explore a practical measurement approach alongside the coaching offer."
  />
</BaseLayout>
