---
import BaseLayout from "../layouts/BaseLayout.astro";
import ElevenLabsCoach from "../components/ElevenLabsCoach.astro";

const challenges = [
  ["Plenty of activity. No simple story.", "You are doing valuable work, but the evidence sits across reports, spreadsheets, conversations and people’s heads."],
  ["Measures chosen for reporting, not learning.", "Teams collect what funders ask for, yet still struggle to see what is changing and what to improve."],
  ["Powerful stories without the wider picture.", "Individual experiences matter, but they become stronger when they sit alongside useful service data and outcomes."],
];

const steps = [
  ["01", "Start with people", "Be clear about who should benefit and the change that matters to them."],
  ["02", "Trace the change", "Connect what you do to the outcomes you hope to create and surface the assumptions in between."],
  ["03", "Choose useful evidence", "Combine stories, feedback, service data and outcome measures without overloading your team."],
  ["04", "Learn and improve", "Turn the evidence into decisions, stronger delivery and a clearer account of your impact."],
];

const outputs = [
  ["A clear impact story", "Explain who you support, what changes and why your approach matters."],
  ["A proportionate evidence plan", "Choose a small set of measures and evidence sources that your team can realistically use."],
  ["A practical 90-day plan", "Leave with focused next steps to improve, test and communicate your impact."],
  ["A copy sent to your inbox", "Ask the advisor to email your tailored plan so you can share it with your team."],
];
---

<BaseLayout
  title="Free Social Impact Advisor | SEUK Partner Tool | Bridgit Care"
  description="Use Bridgit's free Social Impact Advisor, delivered in partnership with Social Enterprise UK, to clarify your impact, choose meaningful evidence and create a practical improvement plan."
  image="/images/tools/social-impact-advisor-watercolour.jpg"
>
  <section class="section impact-hero">
    <div class="shell impact-hero-grid">
      <div class="impact-copy">
        <p class="eyebrow dark">Free guided social impact tool</p>
        <h1>Turn the difference you make into evidence people can act on.</h1>
        <p class="lead">You already know your work matters. The harder part is explaining who benefits, what changes, how you know and what to improve next.</p>
        <p>Talk it through with Bridgit’s Social Impact Advisor. It will help you build a practical impact story, a proportionate way to measure it and a focused plan for what comes next.</p>
        <div class="button-row">
          <a class="button" href="#start-review">Start my impact review</a>
          <a class="button button-secondary" href="#what-you-create">See what I’ll create</a>
        </div>
      </div>

      <div class="impact-visual-column">
        <div class="partner-lockup">
          <span>Delivered in partnership with</span>
          <img src="/images/landing/social-enterprise-uk-member.webp" alt="Social Enterprise UK Members' Partner" width="220" height="92" />
        </div>
        <figure class="impact-visual">
          <img src="/images/tools/social-impact-advisor-watercolour.jpg" alt="A social impact advisor helping a team connect people's experiences, evidence and community outcomes" width="1536" height="1024" />
          <figcaption>
            <span><b>01</b> Listen to people</span>
            <span><b>02</b> Find useful evidence</span>
            <span><b>03</b> Learn and improve</span>
          </figcaption>
        </figure>
        <p class="email-note"><span aria-hidden="true">✉</span><strong>Your thinking will not disappear when the conversation ends.</strong> Ask the advisor to email your tailored plan to you.</p>
      </div>
    </div>
  </section>

  <section class="section impact-problem">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow dark">Does this sound familiar?</p><h2>Your impact is real. Showing it can be messy.</h2></div>
        <p>You do not need a perfect theory of change or a new reporting system to begin. Start with what you know, what people tell you and the evidence you already collect.</p>
      </div>
      <div class="challenge-grid">
        {challenges.map(([title, copy], index) => <article><span>0{index + 1}</span><h3>{title}</h3><p>{copy}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section impact-output" id="what-you-create">
    <div class="shell output-grid">
      <div class="output-intro">
        <p class="eyebrow">What you will create</p>
        <h2>A useful starting point, not another weighty report.</h2>
        <p>The advisor asks one clear question at a time and adapts to your organisation. Bring an early idea, an existing framework or a reporting challenge you cannot quite untangle.</p>
        <a class="text-link" href="#start-review">Talk it through with the advisor <span aria-hidden="true">→</span></a>
      </div>
      <div class="output-cards">
        {outputs.map(([title, copy], index) => <article><span aria-hidden="true">{["◎", "◇", "↗", "✉"][index]}</span><div><h3>{title}</h3><p>{copy}</p></div></article>)}
      </div>
    </div>
  </section>

  <section class="section impact-journey">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow dark">Follow the impact thread</p><h2>From people’s experiences to better decisions.</h2></div>
        <p>Good impact practice joins four things together. The advisor helps you work through each one without turning the process into a tick-box exercise.</p>
      </div>
      <div class="journey-grid">
        {steps.map(([number, title, copy]) => <article><span>{number}</span><h3>{title}</h3><p>{copy}</p></article>)}
      </div>
      <p class="journey-line"><strong>Keep it proportionate.</strong> Measure what helps you understand, improve and communicate your work. Leave out data that nobody will use.</p>
    </div>
  </section>

  <section class="section impact-start" id="start-review">
    <div class="shell start-grid">
      <div>
        <p class="eyebrow">Start where you are</p>
        <h2>Bring one question. Leave with a clearer plan.</h2>
        <p>You can talk or type. The advisor will help you think, challenge vague claims and translate your answers into practical next steps.</p>
      </div>
      <ol>
        <li><span>1</span><p><strong>Describe the difference</strong>Who do you support and what change are you trying to create?</p></li>
        <li><span>2</span><p><strong>Explore the evidence</strong>What do you already know, and where are the gaps?</p></li>
        <li><span>3</span><p><strong>Build your next steps</strong>Choose what to measure, learn and improve over the next 90 days.</p></li>
      </ol>
    </div>
  </section>

  <section class="section impact-trust">
    <div class="shell trust-grid">
      <div>
        <p class="eyebrow dark">Grounded in trusted practice</p>
        <h2>Practical guidance with social value at its heart.</h2>
        <p>The advisor draws on established social impact and social value principles, then translates them into questions your organisation can answer and use.</p>
      </div>
      <div class="source-list">
        <a href="https://www.socialenterprise.org.uk/social-enterprise-uk-impact-reports/"><span>SEUK</span><div><strong>Social Enterprise UK impact reports</strong><small>Evidence and insight from the UK social enterprise movement.</small></div></a>
        <a href="https://www.socialvalueint.org/principles"><span>SVI</span><div><strong>Social Value International principles</strong><small>A recognised framework for understanding and managing social value.</small></div></a>
        <a href="https://www.gov.uk/government/publications/ppn-002-taking-account-of-social-value-in-the-award-of-contracts/ppn-002-taking-account-of-social-value-in-the-award-of-contracts-html"><span>UK</span><div><strong>Government social value guidance</strong><small>Current expectations for taking account of social value in public contracts.</small></div></a>
      </div>
      <p class="boundary"><strong>A helpful thinking partner, not an auditor.</strong> The advisor supports planning and reflection. It does not verify claims, provide financial assurance or replace independent evaluation where that is required.</p>
    </div>
  </section>

  <section class="section impact-download">
    <div class="shell impact-download-card">
      <div><p class="eyebrow dark">Take the overview with you</p><h2>Share the Social Impact Advisor with your team.</h2><p>Download the single-page A4 guide for a clear summary of what the advisor does, what you will create and how to get started.</p></div>
      <a class="button" href="/downloads/social-impact-advisor-guide.png" download>Download the A4 guide</a>
    </div>
  </section>

  <ElevenLabsCoach
    agentId="agent_7401m0f1k7zsfm9953k0pq0fvn8s"
    coachName="Social Impact Advisor"
    actionText="Start my impact review"
    commonQuestions={["Help me explain the difference our organisation makes", "What should we measure without overloading our team?", "How can we combine stories and service data?", "Help me create a 90-day impact plan"]}
  />
</BaseLayout>

<style>
  .impact-hero{overflow:hidden;background:radial-gradient(circle at 86% 7%,rgba(64,174,166,.18),transparent 29%),radial-gradient(circle at 8% 92%,rgba(220,46,159,.15),transparent 30%),linear-gradient(145deg,#fffafd,#f3f7ff)}
  .impact-hero-grid{display:grid;grid-template-columns:.96fr 1.04fr;gap:clamp(32px,4.5vw,68px);align-items:start}
  .impact-copy h1{max-width:720px;color:#172136;font-size:clamp(49px,5.8vw,78px);line-height:1.01}
  .impact-copy>.lead{max-width:690px;margin-top:22px;color:#414d68;font-size:clamp(21px,2vw,27px);line-height:1.5}
  .impact-copy>p:not(.eyebrow,.lead,.email-note){max-width:670px;color:#5a647a}
  .impact-visual-column{display:grid;gap:16px;min-width:0}.partner-lockup{display:flex;align-items:center;gap:14px;width:max-content;max-width:100%;margin:0;padding:9px 12px 9px 16px;border:1px solid #ecd8e7;border-radius:16px;background:rgba(255,255,255,.8);box-shadow:0 10px 28px rgba(62,27,80,.07)}
  .partner-lockup span{color:#5d516d;font-size:12px;font-weight:900;letter-spacing:.06em;text-transform:uppercase}
  .partner-lockup img{width:112px;height:44px;object-fit:contain}
  .impact-copy .button-secondary{border-color:#d8c5e8;color:#5d24bb}
  .email-note{display:grid;grid-template-columns:42px 1fr;column-gap:13px;align-items:center;max-width:none;margin:0 1%;padding:15px 18px;border:1px solid #e3cce5;border-radius:19px;background:rgba(255,255,255,.88);color:#555d72}
  .email-note span{grid-row:1/3;display:grid;place-items:center;width:42px;height:42px;border-radius:14px;background:#f8e0f1;color:#bb228f}.email-note strong{color:#3c1d68}
  .impact-visual{position:relative;margin:0;padding-bottom:36px}
  .impact-visual>img{display:block;width:100%;aspect-ratio:3/2;object-fit:cover;border:1px solid #eaddec;border-radius:42px;background:#241632;box-shadow:0 30px 80px rgba(41,21,65,.2)}
  .impact-visual figcaption{position:absolute;right:5%;bottom:3px;left:5%;display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
  .impact-visual figcaption span{display:flex;align-items:center;gap:9px;min-height:62px;padding:13px 15px;border:1px solid #eaddec;border-radius:17px;background:#fff;color:#342150;font-size:14px;font-weight:900;box-shadow:0 14px 30px rgba(52,26,72,.12)}
  .impact-visual figcaption b{color:#cf279c}
  .impact-problem{background:#fff}.impact-problem h2,.impact-journey h2,.impact-trust h2{color:#172136}
  .challenge-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .challenge-grid article{padding:28px;border:1px solid #e8ddea;border-radius:27px;background:linear-gradient(145deg,#fff,#fcf7fc);box-shadow:0 17px 45px rgba(68,33,81,.07)}
  .challenge-grid span{display:grid;place-items:center;width:46px;height:46px;border-radius:14px;background:#f4ddf0;color:#b91d8a;font-weight:900}.challenge-grid h3{margin:19px 0 9px;color:#3d1d68;font-size:23px}.challenge-grid p{margin:0;color:#626a7c}
  .impact-output{background:linear-gradient(135deg,#321061,#6a26b3 58%,#244f96);color:#fff}
  .output-grid{display:grid;grid-template-columns:.78fr 1.22fr;gap:clamp(44px,8vw,105px);align-items:center}.output-intro h2{margin:10px 0 20px;font-size:clamp(40px,5vw,65px)}.output-intro p:not(.eyebrow){color:#eee7f8}.text-link{display:inline-flex;gap:10px;margin-top:12px;color:#fff;font-weight:900;text-decoration:underline;text-underline-offset:5px}
  .output-cards{display:grid;grid-template-columns:repeat(2,1fr);gap:15px}.output-cards article{display:grid;grid-template-columns:52px 1fr;gap:14px;padding:22px;border:1px solid rgba(255,255,255,.2);border-radius:22px;background:rgba(255,255,255,.11);backdrop-filter:blur(8px)}.output-cards article>span{display:grid;place-items:center;width:52px;height:52px;border-radius:16px;background:#fff;color:#b82791;font-size:25px;font-weight:900}.output-cards h3{margin:2px 0 6px;color:#fff;font-size:21px}.output-cards p{margin:0;color:#eee7f8;font-size:16px}
  .impact-journey{overflow:hidden;background:linear-gradient(150deg,#faf7ff,#f0f8fa)}
  .journey-grid{position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:17px}.journey-grid:before{position:absolute;top:39px;right:8%;left:8%;height:3px;background:linear-gradient(90deg,#be2799,#6e2fc0,#2ca7bb);content:""}
  .journey-grid article{position:relative;padding:26px 24px;border:1px solid #e0d9eb;border-radius:25px;background:#fff;box-shadow:0 18px 42px rgba(55,34,84,.08)}.journey-grid article>span{position:relative;z-index:1;display:grid;place-items:center;width:52px;height:52px;border:5px solid #fff;border-radius:50%;background:linear-gradient(135deg,#d12b9d,#5d28bd);color:#fff;font-weight:900;box-shadow:0 7px 16px rgba(79,36,133,.22)}.journey-grid h3{margin:22px 0 8px;color:#4b2091;font-size:23px}.journey-grid p{margin:0;color:#616a7c}
  .journey-line{max-width:940px;margin:28px auto 0;padding:17px 22px;border:1px solid #d9cbe8;border-radius:18px;background:#fff;text-align:center;color:#555f73}.journey-line strong{color:#4c218d}
  .impact-start{background:linear-gradient(135deg,#b5238c,#7029ba 55%,#2b82b7);color:#fff}.start-grid{display:grid;grid-template-columns:.88fr 1.12fr;gap:clamp(42px,8vw,100px);align-items:center}.start-grid h2{margin:10px 0 18px;font-size:clamp(41px,5vw,65px)}.start-grid>div>p:not(.eyebrow){color:#f4eaf5}.start-grid ol{display:grid;gap:13px;margin:0;padding:0;list-style:none}.start-grid li{display:grid;grid-template-columns:48px 1fr;gap:15px;padding:19px;border:1px solid rgba(255,255,255,.25);border-radius:20px;background:rgba(255,255,255,.13)}.start-grid li>span{display:grid;place-items:center;width:48px;height:48px;border-radius:14px;background:#fff;color:#8b25ad;font-weight:900}.start-grid li p{display:grid;gap:2px;margin:0;color:#f4eaf5}.start-grid li strong{color:#fff;font-size:18px}
  .impact-trust{background:#fff}.trust-grid{display:grid;grid-template-columns:.82fr 1.18fr;gap:clamp(40px,7vw,90px);align-items:start}.impact-trust h2{margin:10px 0 17px;font-size:clamp(39px,5vw,59px)}.source-list{display:grid;gap:12px}.source-list a{display:grid;grid-template-columns:54px 1fr;gap:15px;align-items:center;padding:18px;border:1px solid #e4ddeb;border-radius:19px;background:#fbf9fd;color:#4e1e85;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease}.source-list a:hover{transform:translateY(-2px);box-shadow:0 13px 30px rgba(55,31,75,.09)}.source-list>a>span{display:grid;place-items:center;width:54px;height:54px;border-radius:16px;background:linear-gradient(135deg,#f6dff0,#dff2f6);color:#8c2186;font-weight:900}.source-list div{display:grid;gap:3px}.source-list small{color:#687084;font-size:14px}.boundary{grid-column:1/-1;margin:8px 0 0;padding:17px 20px;border-left:4px solid #c32a99;background:#faf6fc;color:#596175}.boundary strong{color:#3e1c6f}
  .impact-download{padding-top:0;background:#fff}.impact-download-card{display:grid;grid-template-columns:1fr auto;gap:38px;align-items:center;padding:38px;border:1px solid #dfd4e8;border-radius:30px;background:radial-gradient(circle at 92% 14%,rgba(52,172,177,.18),transparent 30%),linear-gradient(135deg,#fff8fd,#f2f7ff);box-shadow:0 18px 44px rgba(55,31,75,.08)}.impact-download h2{margin:8px 0;color:#32135a;font-size:clamp(31px,4vw,48px)}.impact-download p:not(.eyebrow){max-width:760px;margin:0;color:#5c6477}.impact-download .button{white-space:nowrap}
  @media(max-width:980px){.impact-hero-grid,.output-grid,.start-grid,.trust-grid{grid-template-columns:1fr}.impact-visual-column{max-width:820px}.journey-grid{grid-template-columns:repeat(2,1fr)}.journey-grid:before{display:none}}
  @media(max-width:760px){.challenge-grid{grid-template-columns:1fr}.output-cards{grid-template-columns:1fr}.impact-visual figcaption{position:relative;right:auto;bottom:auto;left:auto;grid-template-columns:1fr;margin:-20px 15px 0}.impact-visual{padding-bottom:0}.partner-lockup{align-items:flex-start;flex-direction:column}.journey-grid{grid-template-columns:1fr}.impact-download-card{grid-template-columns:1fr;padding:28px}.impact-download .button{justify-self:start}}
  @media(max-width:520px){.impact-visual>img{border-radius:27px}.impact-visual figcaption span{min-height:52px}.output-cards article{grid-template-columns:46px 1fr}.output-cards article>span{width:46px;height:46px}}
</style>
