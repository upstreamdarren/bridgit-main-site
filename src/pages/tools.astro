---
import BaseLayout from "../layouts/BaseLayout.astro";

const tools = [
  {
    eyebrow: "Delivered with SEUK",
    title: "Social Impact Advisor",
    copy: "Understand the change you create, choose meaningful measures and build a practical 90-day plan to strengthen your social impact.",
    href: "/social-impact-advisor",
    image: "/images/tools/social-impact-advisor-hero.jpg",
    alt: "A social impact advisor helping a team connect people's experiences, evidence and community outcomes"
  },
  {
    eyebrow: "Co-production",
    title: "Build a co-production plan with Sandy",
    copy: "Turn an idea, service change or engagement challenge into a practical plan shaped around lived experience, access, shared decisions and a clear feedback loop.",
    href: "/sandy",
    image: "https://bridgit.care/wp-content/uploads/2026/07/sandy-welcome.png",
    alt: "Sandy, Bridgit's co-production coach"
  },
  {
    eyebrow: "Digital commissioning",
    title: "Move from community need to a confident digital brief",
    copy: "Explore the problem, compare realistic digital and AI routes, test representative suppliers and receive a tailored recommendation report by email.",
    href: "/commissioners-digital-toolkit",
    image: "/images/tools/commissioner-toolkit-hero.webp",
    alt: "A commissioner mapping community needs into digital service options"
  },
  {
    eyebrow: "Digital strategy",
    title: "Digital Readiness Review",
    copy: "Identify the people, journeys, systems and safeguards that shape a safe first digital step for your organisation.",
    href: "/digital-readiness-review",
    image: "/images/landing/responsible-ai-consultancy.webp",
    alt: "A team discussing a responsible digital service"
  },
  {
    eyebrow: "Service improvement",
    title: "Demand and Capacity Planner",
    copy: "Map repeat contact, pressure points and opportunities to give people clearer help earlier, while freeing time for complex work.",
    href: "/demand-capacity-planner",
    image: "/images/landing/challenges/local-authorities.webp",
    alt: "A community support team mapping demand"
  },
  {
    eyebrow: "Connected support",
    title: "Pathway Mapper",
    copy: "Follow a person's route from first question to the right help and find where information, handovers or momentum break down.",
    href: "/pathway-mapper",
    image: "/images/tools/commissioning-journey.webp",
    alt: "A connected support journey"
  },
  {
    eyebrow: "Responsible AI",
    title: "Responsible AI Action Plan",
    copy: "Turn an AI idea into a proportionate, people-centred plan with human oversight, data and inclusion in view.",
    href: "/responsible-ai-action-plan",
    image: "/images/landing/responsible-ai-consultancy.webp",
    alt: "A team planning responsible use of AI"
  },
  {
    eyebrow: "Partnership working",
    title: "Partnership Builder",
    copy: "Build a shared plan with the right people, roles, decisions and learning around a common community outcome.",
    href: "/partnership-builder",
    image: "/images/landing/seuk-expertise-journey.webp",
    alt: "Partners working together around social impact"
  }
];
---

<BaseLayout title="Free Guided Tools for Services and Social Impact | Bridgit Care" description="Use Bridgit's free guided tools to strengthen co-production, digital commissioning, responsible AI, social impact and service improvement." image="/images/tools/commissioner-toolkit-hero.webp">
  <section class="section tools-hero">
    <div class="shell tools-hero-grid">
      <div><p class="eyebrow dark">Practical tools from Bridgit</p><h1>Turn a difficult starting point into a plan you can use.</h1></div>
      <p>Eight guided coaches combine trusted public-service and social-impact guidance with the questions our team uses in real projects. Talk or type, work at your own pace and ask for a copy of your plan when you finish.</p>
    </div>
  </section>

  <section class="section tools-list" aria-labelledby="tools-title">
    <div class="shell">
      <h2 class="sr-only" id="tools-title">Choose a Bridgit tool</h2>
      <div class="tools-grid">
        {tools.map((tool, index) => (
          <article class:list={["tool-card", index === 0 && "tool-card-featured"]}>
            <div class="tool-card-visual"><img src={tool.image} alt={tool.alt} width="1536" height="1024" loading={index === 0 ? "eager" : "lazy"} /></div>
            <div class="tool-card-copy">
              <p class="eyebrow dark">{tool.eyebrow}</p>
              <h2>{tool.title}</h2>
              <p>{tool.copy}</p>
              <a class="button" href={tool.href}>Open the free tool</a>
            </div>
          </article>
        ))}
      </div>
      <aside class="tools-note"><strong>Designed to support judgement, not replace it.</strong><span>Use the outputs as a working draft. Involve the people affected and check your organisation's governance, commercial and safeguarding requirements.</span></aside>
    </div>
  </section>
</BaseLayout>

<style>
  .tools-hero{background:radial-gradient(circle at 8% 15%,rgba(205,46,174,.17),transparent 29%),radial-gradient(circle at 90% 20%,rgba(75,170,207,.16),transparent 28%),linear-gradient(145deg,#fff,#f7f3fb)}
  .tools-hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:clamp(40px,8vw,110px);align-items:end}
  .tools-hero h1{max-width:820px;color:#171b2f;font-size:clamp(48px,6vw,76px)}
  .tools-hero-grid>p{margin:0;color:#5f5970;font-size:21px}
  .tools-list{background:#fff}
  .tools-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
  .tool-card{overflow:hidden;border:1px solid #e4d9ec;border-radius:34px;background:#fff;box-shadow:0 22px 58px rgba(47,19,76,.11)}
  .tool-card-visual{height:230px;overflow:hidden;background:#f5f1f8}
  .tool-card-visual img{width:100%;height:100%;object-fit:cover;object-position:center}
  .tool-card-featured{grid-column:span 2;display:grid;grid-template-columns:1.08fr .92fr;background:linear-gradient(145deg,#fff,#faf5fb)}
  .tool-card-featured .tool-card-visual{height:100%;min-height:390px}
  .tool-card-featured .tool-card-copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(34px,5vw,58px)}
  .tool-card-featured .tool-card-copy>p:not(.eyebrow){min-height:0;font-size:19px}
  .tool-card-featured .button{align-self:flex-start}
  .tool-card-copy{padding:34px}
  .tool-card h2{margin:10px 0 16px;color:#251039;font-size:clamp(27px,2.7vw,38px)}
  .tool-card-copy>p:not(.eyebrow){min-height:112px;color:#625b6e}
  .tools-note{display:grid;grid-template-columns:auto 1fr;gap:22px;margin-top:26px;padding:22px 26px;border-radius:20px;background:linear-gradient(100deg,#f4eef9,#eef8fb);color:#51475c}
  .tools-note strong{color:#52158f}
  @media(max-width:1050px){.tools-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:850px){.tools-hero-grid,.tools-grid{grid-template-columns:1fr}.tool-card-featured{grid-column:auto;grid-template-columns:1fr}.tool-card-featured .tool-card-visual{min-height:280px}.tool-card-copy>p:not(.eyebrow){min-height:0}}
  @media(max-width:560px){.tool-card{border-radius:25px}.tool-card-visual{height:230px}.tool-card-copy{padding:25px}.tools-note{grid-template-columns:1fr;gap:6px}}
</style>
