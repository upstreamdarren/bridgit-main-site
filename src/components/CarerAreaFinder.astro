---
import { carerRegions } from "../data/carerRegions";
---

<section class="portal-section portal-area-section" id="local-support" aria-labelledby="area-finder-title">
  <div class="portal-shell">
    <div class="portal-section-heading">
      <div>
        <p class="portal-eyebrow portal-eyebrow-dark">Support where you live</p>
        <h2 id="area-finder-title">Find your local Bridgit service.</h2>
      </div>
      <p>Search by town, council area or delivery organisation. Choose a pin or a result to open the right locally branded service.</p>
    </div>

    <div class="area-finder" data-area-finder>
      <div class="area-map-panel">
        <div class="area-map-copy">
          <span class="area-map-kicker">Bridgit across the UK</span>
          <strong>{carerRegions.filter(region => !region.comingSoon).length} local routes live</strong>
          <p>Each service connects national carer guidance with the organisations and pathways available in your area.</p>
        </div>
        <div class="uk-map" aria-label="Map of Bridgit adult carer service areas">
          <svg class="uk-map-shape" viewBox="0 0 300 520" role="img" aria-label="Stylised map of the United Kingdom">
            <path d="M137 18l29 18 5 34-18 25 22 22-4 38 22 20-17 34 9 35 30 28-5 42 28 34-4 38-33 21-19 44-34 25-20 47-35 20-18-29 10-39-23-30 13-39-16-31 10-45-18-37 19-34-2-42 24-31-2-34 25-25 5-40 25-28z" fill="url(#mapGradient)" stroke="currentColor" stroke-width="3" />
            <path d="M65 354l-29 17-15-17 14-25 27-4zM238 442l30 19-15 24-27-9z" fill="#ece4f8" stroke="currentColor" stroke-width="3" />
            <defs><linearGradient id="mapGradient" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#efe4ff"/><stop offset="1" stop-color="#dff4fb"/></linearGradient></defs>
          </svg>
          {carerRegions.filter(region => !region.comingSoon).map(region => (
            <button class="area-pin" type="button" style={`--pin-x:${region.x}%;--pin-y:${region.y}%;`} data-area-pin={region.area} aria-label={`Show ${region.area}`} title={region.area}><span></span></button>
          ))}
        </div>
      </div>

      <div class="area-results-panel">
        <label class="area-search-label" for="area-search">Search for your area</label>
        <div class="area-search-wrap">
          <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
          <input id="area-search" type="search" placeholder="Try Sandwell, Devon or Carers Network" autocomplete="postal-code" data-area-search />
        </div>
        <p class="area-result-summary" role="status" data-area-summary>Showing featured local services</p>
        <div class="area-card-list" data-area-list>
          {carerRegions.map((region, index) => (
            <article class:list={["area-card", index >= 7 && "area-card-extra"]} data-area-card data-search={`${region.area} ${region.organisation}`.toLowerCase()}>
              <div class="area-logo">
                {region.logo ? <img src={region.logo} alt="" width="180" height="80" loading="lazy" /> : <span>{region.organisation.split(/\s+/).slice(0, 2).map(word => word[0]).join("")}</span>}
              </div>
              <div class="area-card-copy">
                <h3>{region.area}</h3>
                <p>{region.organisation}</p>
              </div>
              {region.comingSoon
                ? <a class="area-link area-link-muted" href="#area-help">Coming soon <span aria-hidden="true">→</span></a>
                : <a class="area-link" href={region.href}>Open local service <span aria-hidden="true">→</span></a>}
            </article>
          ))}
        </div>
        <button class="area-show-all" type="button" data-area-show-all>Show all {carerRegions.length} areas</button>
        <div class="area-help" id="area-help">
          <strong>Can’t find your area?</strong>
          <p>You can still use Bridgit’s general support or contact us and we’ll help you find the right route.</p>
          <a href="https://carers.bridgit.care/app/">Use general carer support</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const finder = document.querySelector("[data-area-finder]");
  if (finder) {
    const search = finder.querySelector("[data-area-search]");
    const cards = [...finder.querySelectorAll("[data-area-card]")];
    const summary = finder.querySelector("[data-area-summary]");
    const showAll = finder.querySelector("[data-area-show-all]");
    let expanded = false;

    const filterCards = (value = "") => {
      const term = value.trim().toLowerCase();
      let visible = 0;
      cards.forEach((card, index) => {
        const matches = !term || card.getAttribute("data-search")?.includes(term);
        const withinInitialSet = expanded || index < 7 || Boolean(term);
        const show = Boolean(matches && withinInitialSet);
        card.hidden = !show;
        if (show) visible += 1;
      });
      if (summary) summary.textContent = term ? `${visible} ${visible === 1 ? "service" : "services"} found` : expanded ? `Showing all ${visible} areas` : "Showing featured local services";
      if (showAll) showAll.hidden = Boolean(term) || expanded;
    };

    search?.addEventListener("input", event => filterCards(event.target.value));
    showAll?.addEventListener("click", () => { expanded = true; filterCards(search?.value || ""); });
    finder.querySelectorAll("[data-area-pin]").forEach(pin => pin.addEventListener("click", () => {
      const area = pin.getAttribute("data-area-pin") || "";
      if (search) search.value = area;
      filterCards(area);
      finder.querySelector(".area-results-panel")?.scrollIntoView({ behavior: "smooth", block: "nearest" });
      search?.focus();
    }));
    filterCards();
  }
</script>
