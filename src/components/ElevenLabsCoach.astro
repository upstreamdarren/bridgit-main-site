---
interface Props {
  agentId: string;
  actionText: string;
  coachName?: string;
  commonQuestions?: string[];
}

const {
  agentId,
  actionText,
  coachName = "Bridgit",
  commonQuestions = []
} = Astro.props;

const starterId = `coach-starters-${agentId}`;
const widgetConfig = {
  agentId,
  actionText,
  coachName
};
---

<div class="coach-dock">
  {commonQuestions.length > 0 && (
    <aside class="coach-starters" data-coach-starters>
      <button
        class="coach-starters-toggle"
        type="button"
        aria-label="Show suggested questions"
        aria-expanded="false"
        aria-controls={starterId}
        data-coach-starters-toggle
      >
        <span class="coach-starters-mark" aria-hidden="true">?</span>
      </button>
      <div class="coach-starters-panel" id={starterId} hidden data-coach-starters-panel>
        <div class="coach-starters-heading">
          <div><span>Conversation starters</span><strong>Try asking {coachName}...</strong></div>
          <button type="button" aria-label="Close conversation starters" data-coach-starters-close>&times;</button>
        </div>
        <ul>
          {commonQuestions.map((question) => (
            <li>
              <span>{question}</span>
              <button type="button" data-coach-copy={question} aria-label={`Copy question: ${question}`}>
                <span data-copy-label>Copy</span>
              </button>
            </li>
          ))}
        </ul>
        <p>Copy a question, open Bridgit and paste it into the message box.</p>
      </div>
    </aside>
  )}

  <button
    class="coach-launcher"
    type="button"
    data-elevenlabs-launcher
    data-widget-config={JSON.stringify(widgetConfig)}
  >
    <span class="coach-launcher-mark" aria-hidden="true"><img src="/images/bridgit-care-logo.png" alt="" /></span>
    <span>{actionText}</span>
  </button>
  <div data-elevenlabs-container></div>
</div>

<script is:inline>
  (() => {
    const launcher = document.querySelector("[data-elevenlabs-launcher]");
    const container = document.querySelector("[data-elevenlabs-container]");
    const starters = document.querySelector("[data-coach-starters]");
    const starterToggle = starters?.querySelector("[data-coach-starters-toggle]");
    const starterPanel = starters?.querySelector("[data-coach-starters-panel]");
    const starterClose = starters?.querySelector("[data-coach-starters-close]");
    const copyButtons = starters?.querySelectorAll("[data-coach-copy]") ?? [];
    const externalLaunchers = document.querySelectorAll("[data-open-coach]");
    const dock = launcher?.closest(".coach-dock");
    if (!launcher || !container) return;

    const config = JSON.parse(launcher.dataset.widgetConfig || "{}");
    let widget;
    let loading;

    const setStartersOpen = (open) => {
      if (!starterToggle || !starterPanel) return;
      starterToggle.setAttribute("aria-expanded", String(open));
      starterPanel.hidden = !open;
    };

    starterToggle?.addEventListener("click", () => {
      setStartersOpen(starterToggle.getAttribute("aria-expanded") !== "true");
    });
    starterClose?.addEventListener("click", () => setStartersOpen(false));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setStartersOpen(false);
    });
    const ensureWidgetScript = () => {
      if (customElements.get("elevenlabs-convai")) return Promise.resolve();
      if (loading) return loading;

      loading = new Promise((resolve, reject) => {
        const script = document.createElement("script");
        script.src = "https://unpkg.com/@elevenlabs/convai-widget-embed@0.16.0/dist/index.js";
        script.async = true;
        script.dataset.elevenlabsScript = "true";
        script.addEventListener("load", () => customElements.whenDefined("elevenlabs-convai").then(resolve), { once: true });
        script.addEventListener("error", reject, { once: true });
        document.head.append(script);
      });

      return loading;
    };

    const customiseWidget = () => {
      const root = widget?.shadowRoot;
      if (!root) return false;

      root.querySelectorAll('img[src*="/flags/circle-flags/us.svg"]').forEach((flag) => {
        flag.src = "https://bridgit-main-site.pages.dev/images/uk-flag-round.svg";
        flag.alt = "UK flag";
      });

      root.querySelectorAll("a, div, p, span").forEach((element) => {
        const label = element.textContent?.trim();
        if (/^Powered by (ElevenLabs|ElevenAgents)$/i.test(label)) {
          element.style.setProperty("display", "none", "important");
        }
      });
      return true;
    };

    const connectCustomisation = () => {
      if (!customiseWidget()) {
        requestAnimationFrame(connectCustomisation);
        return;
      }
      new MutationObserver(customiseWidget).observe(widget.shadowRoot, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ["src"]
      });
    };

    const expandWidget = () => {
      widget?.dispatchEvent(new CustomEvent("elevenlabs-agent:expand", {
        detail: { action: "expand" }
      }));
    };

    const launchWidget = async () => {
      if (widget) {
        expandWidget();
        dock?.classList.remove("coach-dock-attention");
        requestAnimationFrame(() => dock?.classList.add("coach-dock-attention"));
        return widget;
      }
      launcher.setAttribute("aria-busy", "true");

      try {
        await ensureWidgetScript();
        widget = document.createElement("elevenlabs-convai");
        const attributes = {
          id: `elevenlabs-coach-${config.agentId}`,
          "agent-id": config.agentId,
          variant: "expandable",
          dismissible: "true",
          "default-expanded": "true",
          "action-text": config.actionText,
          "start-call-text": `Talk with ${config.coachName}`,
          "end-call-text": "Finish conversation",
          "expand-text": `Open ${config.coachName} coach`,
          "listening-text": `${config.coachName} is listening…`,
          "speaking-text": `${config.coachName} is speaking…`,
          "disable-banner": "true",
          "markdown-link-allowed-hosts": "bridgit.care",
          "markdown-link-include-www": "true"
        };
        Object.entries(attributes).forEach(([name, value]) => widget.setAttribute(name, value));
        widget.addEventListener("elevenlabs-convai:call", () => {
          if (starters) starters.hidden = true;
        });
        container.append(widget);
        launcher.hidden = true;
        if (starters) starters.hidden = true;
        connectCustomisation();
        dock?.classList.add("coach-dock-attention");
        return widget;
      } catch (error) {
        console.error("Unable to load the Bridgit coach", error);
        launcher.removeAttribute("aria-busy");
        return null;
      }
    };

    launcher.addEventListener("click", launchWidget);
    externalLaunchers.forEach((trigger) => {
      trigger.addEventListener("click", async (event) => {
        event.preventDefault();
        trigger.setAttribute("aria-busy", "true");
        await launchWidget();
        trigger.removeAttribute("aria-busy");
      });
    });
    copyButtons.forEach((button) => {
      button.addEventListener("click", async () => {
        const question = button.dataset.coachCopy;
        if (!question) return;
        const label = button.querySelector("[data-copy-label]");
        try {
          await navigator.clipboard.writeText(question);
          if (label) label.textContent = "Copied";
          setStartersOpen(false);
          window.setTimeout(() => {
            if (label) label.textContent = "Copy";
          }, 1800);
        } catch (error) {
          console.error("Unable to copy the suggested question", error);
          if (label) label.textContent = "Select text";
        }
      });
    });
  })();
</script>
