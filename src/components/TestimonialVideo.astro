---
interface Props {
  eyebrow?: string;
  title?: string;
  copy?: string;
  compact?: boolean;
}

const {
  eyebrow = "Partner perspective",
  title = "Hear what partnership looks like in practice.",
  copy = "A short conversation about extending trusted support, working alongside local teams and creating measurable impact.",
  compact = false
} = Astro.props;
---

<section class:list={["section", "testimonial-video", { "testimonial-video-compact": compact }]} aria-labelledby="testimonial-video-title">
  <div class="shell testimonial-video-grid">
    <div class="testimonial-video-copy">
      <p class="eyebrow dark">{eyebrow}</p>
      <h2 id="testimonial-video-title">{title}</h2>
      <p>{copy}</p>
    </div>
    <div class="video-frame">
      <iframe
        src="https://player.vimeo.com/video/1211378313?title=0&byline=0&portrait=0"
        title="Bridgit partner testimonial"
        allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
        loading="lazy"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>
