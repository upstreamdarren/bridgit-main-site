---
import PortalCoachTeam from "./PortalCoachTeam.astro";
import PortalVideoFeature from "./PortalVideoFeature.astro";

interface Feature { icon: string; title: string; copy: string; }
interface Step { number: string; title: string; copy: string; }
interface Coach { name: string; role: string; image: string; alt: string; copy: string; topics: string[]; }
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  note: string;
  heroImage: string;
  heroAlt: string;
  primaryUrl: string;
  primaryLabel: string;
  loginUrl: string;
  highlights: string[];
  featuresEyebrow: string;
  featuresTitle: string;
  featuresIntro: string;
  features: Feature[];
  coachesTitle: string;
  coachesIntro: string;
  coaches: Coach[];
  steps: Step[];
  appTitle: string;
  appIntro: string;
  appPoints: string[];
  ctaTitle: string;
  ctaCopy: string;
  ctaLabel: string;
  ctaUrl: string;
}

const {
  eyebrow, title, intro, note, heroImage, heroAlt, primaryUrl, primaryLabel, loginUrl,
  highlights, featuresEyebrow, featuresTitle, featuresIntro, features, steps,
  coachesTitle, coachesIntro, coaches, appTitle, appIntro, appPoints,
  ctaTitle, ctaCopy, ctaLabel, ctaUrl
} = Astro.props;
---

<section class="portal-hero">
  <div class="portal-shell portal-hero-grid">
    <div class="portal-hero-copy">
      <p class="portal-eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="portal-lead">{intro}</p>
      <p class="portal-hero-note"><span aria-hidden="true">♥</span>{note}</p>
      <div class="portal-actions">
        <a class="portal-button" href={primaryUrl}>{primaryLabel}</a>
        <a class="portal-button portal-button-outline" href={loginUrl}>I already have an account</a>
      </div>
    </div>
    <div class="portal-hero-art" aria-label={heroAlt} role="img">
      <span class="portal-orbit portal-orbit-one"></span>
      <span class="portal-orbit portal-orbit-two"></span>
      <img src={heroImage} alt={heroAlt} width="720" height="540" fetchpriority="high" />
      <span class="portal-float portal-float-one">Available when you need it</span>
      <span class="portal-float portal-float-two">Local support, made clearer</span>
    </div>
  </div>
  <div class="portal-shell portal-highlight-row" aria-label="Key benefits">
    {highlights.map((item, index) => <div><span>{String(index + 1).padStart(2, "0")}</span><strong>{item}</strong></div>)}
  </div>
</section>

<section class="portal-section portal-feature-section" id="what-you-get">
  <div class="portal-shell">
    <div class="portal-section-heading">
      <div>
        <p class="portal-eyebrow portal-eyebrow-dark">{featuresEyebrow}</p>
        <h2>{featuresTitle}</h2>
      </div>
      <p>{featuresIntro}</p>
    </div>
    <div class="portal-feature-grid">
      {features.map(feature => (
        <article>
          <span class="portal-feature-icon" aria-hidden="true">{feature.icon}</span>
          <h3>{feature.title}</h3>
          <p>{feature.copy}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<PortalCoachTeam title={coachesTitle} intro={coachesIntro} {coaches} />

<section class="portal-section portal-how" id="how-it-works">
  <div class="portal-shell">
    <div class="portal-section-heading portal-section-heading-light">
      <div>
        <p class="portal-eyebrow">Simple to start</p>
        <h2>Support that turns questions into practical next steps.</h2>
      </div>
      <p>Bridgit helps you understand what matters, find useful guidance and connect with the right people when you need more help.</p>
    </div>
    <ol class="portal-steps">
      {steps.map(step => <li><span>{step.number}</span><h3>{step.title}</h3><p>{step.copy}</p></li>)}
    </ol>
  </div>
</section>

<section class="portal-section portal-app">
  <div class="portal-shell portal-app-grid">
    <div class="portal-app-visual">
      <span class="portal-app-glow"></span>
      <img src="/images/bridgit-app-channels.webp" alt="The Bridgit advice and coaching app on desktop and mobile" width="1432" height="1432" loading="lazy" />
    </div>
    <div>
      <p class="portal-eyebrow portal-eyebrow-dark">Your advice and coaching app</p>
      <h2>{appTitle}</h2>
      <p class="portal-app-intro">{appIntro}</p>
      <ul class="portal-check-list">
        {appPoints.map(point => <li><span aria-hidden="true">✓</span>{point}</li>)}
      </ul>
    </div>
  </div>
</section>

<PortalVideoFeature
  eyebrow="See the app in action"
  title="Advice, coaches and practical tools in one friendly place."
  copy="This short tour shows how Bridgit brings personalised guidance, specialist coaches, saved plans and local support together on mobile and desktop."
  points={["Choose the support area that matters today", "Chat with a coach and receive clear next steps", "Save useful advice, tasks and plans for later"]}
  videoId="1219312452"
  videoHash="709b38d662"
  poster="/images/portal-app-explainer.jpg"
  posterAlt="Preview of the Bridgit app on desktop and mobile with a team of digital coaches"
  buttonLabel="Watch the 1 minute 45 second app tour"
/>

<slot />

<section class="portal-section portal-cta">
  <div class="portal-shell portal-cta-inner">
    <div><p class="portal-eyebrow">Ready when you are</p><h2>{ctaTitle}</h2><p>{ctaCopy}</p></div>
    <a class="portal-button portal-button-light" href={ctaUrl}>{ctaLabel}</a>
  </div>
</section>
