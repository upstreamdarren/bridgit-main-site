---
interface Props {
  siteName: string;
  brandLogo?: string;
  brandLogoAlt?: string;
  brandHomeUrl?: string;
  footerCopy?: string;
  copyrightLabel?: string;
  whiteLabel?: boolean;
  supportHeading?: string;
  supportLinks?: { label: string; href: string }[];
}
const {
  siteName,
  brandLogo = "/images/bridgit-care-logo.png",
  brandLogoAlt = "Bridgit Care",
  brandHomeUrl = "https://bridgit.care/",
  footerCopy = `${siteName} is part of Bridgit Care, providing practical digital support with a clear route to real people.`,
  copyrightLabel = "Bridgit Care",
  whiteLabel = false,
  supportHeading = whiteLabel ? "Birmingham support" : "Your support",
  supportLinks
} = Astro.props;

const links = supportLinks ?? (whiteLabel ? [
  { label: "Explore support", href: "#what-you-get" },
  { label: "Meet the coaches", href: "#meet-your-team" },
  { label: "Warm Welcome partners", href: "#community-partners" }
] : [
  { label: "Adult carer support", href: "https://carers.bridgit.care/" },
  { label: "Young carer support", href: "https://young.bridgit.care/" },
  { label: "Support at work", href: "https://employers.bridgit.care/" }
]);
---

<footer class="portal-footer">
  <div class="portal-shell portal-footer-grid">
    <div>
      <a class:list={["portal-brand", "portal-brand-footer", (whiteLabel || brandLogo !== "/images/bridgit-care-logo.png") && "portal-brand-custom"]} href={brandHomeUrl} aria-label={`${siteName} home`}>
        <img src={brandLogo} alt={brandLogoAlt} width="300" height="103" />
      </a>
      <p>{footerCopy}</p>
    </div>
    <div>
      <h2>{supportHeading}</h2>
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
    <div>
      <h2>Key information</h2>
      {!whiteLabel && <a href="https://bridgit.care/our-impact/">Our impact</a>}
      <a href="/accessibility-statement/">Accessibility</a>
      <a href="/privacy-policy/">Privacy</a>
      <a href="/contact-us/">Contact us</a>
    </div>
  </div>
  <div class="portal-shell portal-footer-bottom">
    <span>Copyright &copy; 2026 {copyrightLabel}</span>
    <span>{whiteLabel ? "Support in Birmingham, made simpler." : "Here for you, every step."}</span>
  </div>
</footer>
