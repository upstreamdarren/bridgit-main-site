---
interface SupportLink {
  title: string;
  copy: string;
  href: string;
}

interface Props {
  links: SupportLink[];
  title?: string;
  copy?: string;
}

const {
  links,
  title = "Ready to turn your plan into support?",
  copy = "The free tool gives you a clear starting point. Bridgit can help you take the next step with digital coaches, practical implementation and support shaped around your service.",
} = Astro.props;
---

<section class="section tool-next" aria-labelledby="tool-next-title">
  <div class="shell tool-next-card">
    <figure class="tool-next-visual">
      <img src="/images/tools/continue-with-bridgit-watercolour.webp" alt="A service team turning a practical plan into connected digital and human support" width="1536" height="1024" loading="lazy" />
    </figure>
    <div class="tool-next-content">
      <p class="eyebrow dark">Continue with Bridgit</p>
      <h2 id="tool-next-title">{title}</h2>
      <p>{copy}</p>
      <div class="tool-next-links">
        {links.map((link, index) => (
          <a href={link.href}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div><strong>{link.title}</strong><small>{link.copy}</small></div>
            <b aria-hidden="true">→</b>
          </a>
        ))}
      </div>
      <a class="tool-next-call" href="/#book-a-call">Not sure which route fits? Book a conversation with our team <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .tool-next{padding-top:clamp(52px,7vw,92px);background:#fff}
  .tool-next-card{overflow:hidden;display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(28px,5vw,70px);align-items:center;padding:clamp(22px,3vw,38px);border:1px solid #ded4e8;border-radius:34px;background:radial-gradient(circle at 7% 9%,rgba(68,174,183,.16),transparent 29%),radial-gradient(circle at 96% 91%,rgba(205,46,163,.13),transparent 30%),linear-gradient(140deg,#fffafc,#f3f7ff);box-shadow:0 24px 62px rgba(52,27,80,.1)}
  .tool-next-visual{overflow:hidden;margin:0;border:1px solid #e2d7e8;border-radius:27px;background:#f8f3ed;box-shadow:0 18px 46px rgba(46,24,67,.12)}
  .tool-next-visual img{display:block;width:100%;aspect-ratio:3/2;object-fit:cover}
  .tool-next-content h2{max-width:760px;margin:9px 0 14px;color:#25113f;font-size:clamp(34px,4.4vw,55px);line-height:1.04}
  .tool-next-content>p:not(.eyebrow){max-width:760px;margin:0 0 22px;color:#5a6072;font-size:18px;line-height:1.55}
  .tool-next-links{display:grid;gap:10px}
  .tool-next-links a{display:grid;grid-template-columns:43px 1fr auto;gap:13px;align-items:center;padding:13px 15px;border:1px solid #ded2e8;border-radius:17px;background:rgba(255,255,255,.92);color:#32125c;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease}
  .tool-next-links a:hover{transform:translateY(-2px);border-color:#c9afe0;box-shadow:0 12px 28px rgba(59,27,90,.1)}
  .tool-next-links a>span{display:grid;place-items:center;width:43px;height:43px;border-radius:13px;background:linear-gradient(135deg,#e6f2fb,#f6dced);color:#8223a3;font-size:11px;font-weight:900}
  .tool-next-links a div{display:grid;gap:2px}.tool-next-links strong{font-size:17px}.tool-next-links small{color:#646b7c;font-size:14px;line-height:1.35}.tool-next-links b{color:#9b259d;font-size:21px}
  .tool-next-call{display:inline-flex;gap:9px;margin-top:19px;color:#571595;font-weight:900;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:5px}
  @media(max-width:900px){.tool-next-card{grid-template-columns:1fr}.tool-next-visual{max-width:760px}.tool-next-content h2{font-size:clamp(36px,8vw,52px)}}
  @media(max-width:560px){.tool-next-card{padding:18px;border-radius:26px}.tool-next-visual{border-radius:21px}.tool-next-links a{grid-template-columns:40px 1fr auto;padding:12px}.tool-next-links a>span{width:40px;height:40px}.tool-next-links small{font-size:13px}}
</style>
