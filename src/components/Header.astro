---
const solutionLinks = [
  {
    label: "Carer services",
    href: "/carer-services",
    description: "For organisations supporting adult, young and working carers."
  },
  {
    label: "Councils and neighbourhoods",
    href: "/local-authorities",
    description: "For councils connecting residents with local and VCSE support."
  },
  {
    label: "Care leaving services",
    href: "/care-leavers",
    description: "For teams helping care-experienced young people move forward."
  },
  {
    label: "Healthy ageing services",
    href: "/healthy-ageing",
    description: "For organisations helping older people stay independent and connected."
  },
  {
    label: "Social enterprises",
    href: "/social-enterprises",
    description: "For purpose-led organisations ready to scale their support and impact."
  },
  {
    label: "NHS partners",
    href: "/nhs",
    description: "For NHS teams extending preventative, non-clinical support."
  },
  {
    label: "Corporate partners",
    href: "/corporate-partners",
    description: "For organisations using AI coaches to strengthen delivery."
  },
  {
    label: "Social investors",
    href: "/social-investors",
    description: "For funders growing measurable impact through trusted delivery partners."
  },
  {
    label: "Responsible AI consultancy",
    href: "/responsible-ai",
    description: "For organisations building safe, practical and socially responsible AI."
  },
  {
    label: "International recruit support",
    href: "/international-recruit-support",
    description: "For regional care partnerships helping international recruits live and work well."
  }
];
---

<header class="site-header" data-header>
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Bridgit Care home">
      <img class="brand-logo" src="/images/bridgit-care-logo.png" alt="Bridgit Care" width="300" height="103" />
    </a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-button>
      <span class="sr-only">Open navigation</span>
      <span></span><span></span><span></span>
    </button>
    <nav class="site-nav" id="site-menu" aria-label="Main navigation" data-menu>
      <a href="/#how-it-works">How it works</a>
      <details>
        <summary>Who we help</summary>
        <div class="nav-panel">
          {solutionLinks.map(({ label, href, description }) => (
            <a href={href}>
              <strong>{label}</strong>
              <span>{description}</span>
            </a>
          ))}
        </div>
      </details>
      <a href="/our-impact">Our impact</a>
      <a href="/leadership-team">Our team</a>
      <a href="/blog">Blog</a>
      <a href="/tools">Tools</a>
      <button class="nav-support-link nav-support-button" type="button" data-support-open aria-haspopup="dialog">
        <span class="nav-support-icon" aria-hidden="true">♥</span>
        <span>Get support</span>
      </button>
      <a class="button button-small" href="/#book-a-call">Book a call</a>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector("[data-menu-button]");
  const menu = document.querySelector("[data-menu]");
  button?.addEventListener("click", () => {
    const open = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!open));
    menu?.classList.toggle("is-open", !open);
  });
</script>
